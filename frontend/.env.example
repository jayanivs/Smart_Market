# Frontend Environment Variables
# Copy this file to .env.local for local overrides (git-ignored).

# ── API Base URL ───────────────────────────────────────────────────────────────
# Point to your deployed backend.
# Leave empty or omit for local dev — defaults to http://localhost:8000
VITE_API_BASE=https://market-pulse-api.onrender.com

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Your Google OAuth 2.0 Client ID (safe to expose in frontend bundles).
# Create one at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
