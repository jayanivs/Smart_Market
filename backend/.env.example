# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./sql_app.db

# PostgreSQL (recommended for staging / production):
# DATABASE_URL=postgresql://user:password@host:5432/marketpulse

# ── Redis (required for ARQ background jobs and WebSocket pub/sub) ─────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ─────────────────────────────────────────────────────────
# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production

# Token lifetime in minutes (default: 10080 = 7 days)
JWT_EXPIRE_MINUTES=10080

# ── Dev-mode auth bypass (LOCAL TESTING ONLY) ─────────────────────────────────
# Set to 1 to skip JWT validation and trust X-User-Id header instead.
# MUST be "0" (or unset) in any deployed environment.
DEV_TRUST_HEADER=0

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Market Data Provider ──────────────────────────────────────────────────────
# Use "mock" to run the simulator without a real API key.
MARKET_API_URL=mock
MARKET_API_KEY=mock
